{
  "name": "ecs-network-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Amazon ECS ネットワークモード比較ハンズオンをビジュアルで学ぶゲーム（静的サイト + S3/CloudFront を cdkd でデプロイ）",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "synth": "cdk synth --quiet",
    "check:a11y": "node scripts/check-a11y.mjs",
    "cdkd": "cdkd"
  },
  "devDependencies": {
    "@cdkd/cli": "0.336.0",
    "@types/node": "22.20.5",
    "aws-cdk": "2.1148.0",
    "axe-core": "4.14.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "aws-cdk-lib": "2.275.0",
    "cdk-nag": "3.0.2",
    "constructs": "10.8.1"
  }
}
